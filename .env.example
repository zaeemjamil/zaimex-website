# Copy this file to .env.local for local development and fill in real values.
# All variables are optional — every one already has a sensible, documented
# default in /src/config (see comments there). Set real values in your Vercel
# project settings before deploying to production.

# Canonical production URL (used for metadata, canonical tags, sitemap, structured data).
# No real domain has been confirmed for ZAIMEX yet — leave this unset until one
# exists. It then falls back — in order — to Vercel's own deployment URL
# (VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL, auto-injected on Vercel, no setup
# required) and then to http://localhost:3000 locally. It never silently
# assumes zaimex.com or any other domain you don't actually own.
# Example once you have one: NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_URL=

# Contact — real, confirmed ZAIMEX business details (src/config/site.ts falls
# back to these exact values if the env vars below are left unset, so the site
# is correct out of the box; override here only if you need a different value
# for a specific environment, e.g. a staging inbox).
NEXT_PUBLIC_CONTACT_EMAIL=zaimexteam@gmail.com
# International format, digits only, no "+", spaces or dashes — the exact
# format wa.me links require.
NEXT_PUBLIC_WHATSAPP_NUMBER=923287768285

# Social links — confirmed ZAIMEX profiles. GitHub is intentionally unset
# (ZAIMEX doesn't have a public one yet) — its footer icon stays hidden until set.
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/zaimex/?viewAsMember=true
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/zaimex.official/
NEXT_PUBLIC_GITHUB_URL=

# Optional: enable real email delivery from the /contact form via Resend
# (see src/app/api/contact/route.ts). Leave both unset to keep submissions
# server-logged only — the form still works, it just won't send an email.
#
# 1. Create a free account at https://resend.com
# 2. Dashboard → API Keys → Create API Key → paste it below as RESEND_API_KEY
# 3. Set CONTACT_INBOX_EMAIL to the address that should receive project requests
#    (zaimexteam@gmail.com, unless you want a different inbox for this)
# 4. (Recommended for production) Dashboard → Domains → add and verify your
#    sending domain, then set CONTACT_FROM_EMAIL to an address on that domain,
#    e.g. "ZAIMEX Website <noreply@yourdomain.com>". Until a domain is verified,
#    leaving CONTACT_FROM_EMAIL unset falls back to Resend's shared sandbox
#    sender, which Resend restricts to sending only to your own account email —
#    fine for testing, not for real visitor submissions.
RESEND_API_KEY=
CONTACT_INBOX_EMAIL=
CONTACT_FROM_EMAIL=

